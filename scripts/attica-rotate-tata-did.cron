SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Rotate Tata outbound DID at 06:00, 10:00, 14:00, 18:00, and 22:00 IST.
CRON_TZ=Asia/Kolkata
TZ=Asia/Kolkata
0 6,10,14,18,22 * * * root /usr/local/sbin/attica-rotate-tata-did rotate >/var/log/attica-rotate-tata-did.log 2>&1
