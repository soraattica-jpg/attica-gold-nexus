# Run the production API against a separately provisioned database and PBX.
NODE_ENV=production
ATTICA_DB_PASSWORD=
ATTICA_JUSTDIAL_API_KEY=
ATTICA_WEBSITE_LEAD_API_KEY=
ATTICA_WEBSITE_FORM_LEADS_API_TOKEN=

# Existing file-backed provider and webhook configuration.
ATTICA_META_REALTIME_INGEST_SECRET_FILE=/etc/attica/meta-realtime-ingest-secret
ATTICA_KALEYRA_API_KEY_FILE=/etc/attica/kaleyra-api-key
ATTICA_KALEYRA_DLR_TOKEN_FILE=/etc/attica/sms-dlr-token
ATTICA_GOOGLE_ADS_DEVELOPER_TOKEN=

# Production performance settings from the captured service.
ATTICA_API_WORKERS=8
ATTICA_MAX_API_WORKERS=8
ATTICA_DB_POOL_TOTAL_CONNECTIONS=64
ATTICA_DB_POOL_CONNECTION_LIMIT=6
ATTICA_AUTO_DIAL_ASSIGN_INTERVAL_MS=10000
ATTICA_AUTO_DIAL_AGENT_POLL_MIN_INTERVAL_MS=10000
ATTICA_AUTO_DIAL_MAX_ASSIGNMENTS_PER_RUN=20
ATTICA_OUTBOUND_AUTO_DIAL_CONNECT_GAP_SECONDS=10
ATTICA_MAX_CALLS_FETCH_LIMIT=20000
ATTICA_MAX_REPORT_CALLS_FETCH_LIMIT=20000
ATTICA_MAX_DASHBOARD_FETCH_LIMIT=5000
ATTICA_CALL_SAVE_LOCK_WAIT_SECONDS=20
