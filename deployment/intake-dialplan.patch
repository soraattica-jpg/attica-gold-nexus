  same => n,Set(GSM_DIAL_NUM=${FILTER(0-9,${ARG1})})
  same => n,Set(GSM_DIAL_TIMEOUT=${IF($["${ARG2}"=""]?${OUTBOUND_RING_TIMEOUT}:${ARG2})})
  same => n,ExecIf($[${GSM_DIAL_TIMEOUT} > ${OUTBOUND_RING_TIMEOUT}]?Set(GSM_DIAL_TIMEOUT=${OUTBOUND_RING_TIMEOUT}))
