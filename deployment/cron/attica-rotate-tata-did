SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Rotate Tata outbound DID every 3 hours in IST.
CRON_TZ=Asia/Kolkata
TZ=Asia/Kolkata
0 */3 * * * root /usr/local/sbin/attica-rotate-tata-did rotate >/var/log/attica-rotate-tata-did.log 2>&1
* * * * * root /usr/local/sbin/attica-rotate-tata-did apply-deferred >/var/log/attica-rotate-tata-did-deferred.log 2>&1
