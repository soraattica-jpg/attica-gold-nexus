[Unit]
Description=Attica Gold API Server
After=network.target mariadb.service mysql.service asterisk.service

[Service]
Type=simple
WorkingDirectory=/opt/attica-api
EnvironmentFile=-/etc/attica/attica-api.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
