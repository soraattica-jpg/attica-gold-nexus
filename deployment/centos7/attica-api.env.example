NODE_ENV=production
PORT=3001

# API worker/process tuning
ATTICA_API_WORKERS=2
ATTICA_MAX_API_WORKERS=2
ATTICA_DB_POOL_TOTAL_CONNECTIONS=30
ATTICA_DB_POOL_CONNECTION_LIMIT=6

# Dialer queue timing
ATTICA_AUTO_DIAL_ASSIGN_INTERVAL_MS=30000
ATTICA_AUTO_DIAL_MAX_ASSIGNMENTS_PER_RUN=8
ATTICA_CALL_SAVE_LOCK_WAIT_SECONDS=8

# Optional external integrations
ATTICA_GOOGLE_PLACES_API_KEY=
WATI_DIALER_EVENT_URL=http://127.0.0.1/integrations/wati/dialer_event_receiver.php
WATI_CONFIG_PATH=/etc/attica/wati.config.php
WATI_DIALER_REQUEST_TIMEOUT_MS=15000
