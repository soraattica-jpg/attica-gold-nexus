[global]
type=global
keep_alive_interval=10

;==========================================================
; PJSIP TRANSPORT (WSS via HTTP server on 8089)
;==========================================================
[transport-wss]
type=transport
protocol=wss
bind=0.0.0.0
websocket_write_timeout=300000
external_signaling_address=49.200.166.54
external_media_address=49.200.166.54
local_net=10.53.0.0/16
local_net=192.168.0.0/16

;==========================================================
; WEBRTC ENDPOINT TEMPLATE
;==========================================================
[webrtc-endpoint](!)
type=endpoint
transport=transport-wss
context=default
disallow=all
allow=ulaw
allow=alaw
webrtc=yes
media_encryption=dtls
dtls_setup=actpass
dtls_verify=fingerprint
dtls_cert_file=/etc/asterisk/keys/dtls-combined.pem
dtls_private_key=/etc/asterisk/keys/dtls.key
ice_support=yes
media_use_received_transport=yes
rtcp_mux=yes
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes
rtp_keepalive=15
direct_media=no
; Pass carrier early-media/progress audio (caller tune/announcements) to WebRTC agents.
inband_progress=yes
use_avpf=yes
identify_by=username

[webrtc-auth](!)
type=auth
auth_type=userpass

[webrtc-aor](!)
type=aor
max_contacts=1
default_expiration=300
minimum_expiration=30
maximum_expiration=600
qualify_frequency=60
qualify_timeout=8.0
remove_existing=yes
support_path=yes

; --- Agent 01 (Ext 2001) ---
[2001](webrtc-endpoint)
auth=2001-auth
aors=2001
callerid="WebAgent 01" <2001>

[2001-auth](webrtc-auth)
username=2001
password={{ASTERISK_PJSIP_2001_AUTH_PASSWORD}}

[2001](webrtc-aor)

