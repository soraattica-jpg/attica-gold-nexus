 same => n,Set(CALLER_STICKY_KEY=${FILTER(0-9,${CALLERID(num)})})
 same => n,ExecIf($[${LEN(${CALLER_STICKY_KEY})} > 10]?Set(CALLER_STICKY_KEY=${CALLER_STICKY_KEY:-10}))
 same => n,Set(STICKY_LANG_KEY=${TOLOWER(${FILTER(abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ,${LANG_SELECTED})})})
 same => n,ExecIf($["${STICKY_LANG_KEY}"=""]?Set(STICKY_LANG_KEY=english))
 same => n,Set(CALLER_STICKY_SCOPE=${CALLER_STICKY_KEY}-${STICKY_LANG_KEY})
 same => n,Set(IS_VALID_STICKY_CALLER=1)
 same => n,ExecIf($[${LEN(${CALLER_STICKY_KEY})} != 10]?Set(IS_VALID_STICKY_CALLER=0))
 same => n,ExecIf($["${CALLER_STICKY_KEY}"="8068711200"]?Set(IS_VALID_STICKY_CALLER=0))
 same => n,ExecIf($["${CALLER_STICKY_KEY}"="8068711201"]?Set(IS_VALID_STICKY_CALLER=0))
