 same => n,Set(GROUP(tata-new-direction)=incoming)
 same => n,Set(NEW_TATA_ACTIVE_CHANNELS=${GROUP_COUNT(all@tata-new)})
 same => n,Goto(trunkinbound,+91${EXTEN},1)

