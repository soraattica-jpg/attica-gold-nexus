;==========================================================
; INBOUND CALLS FROM TATA
;==========================================================
;==========================================================
[ivr-main]
exten => s,1,Answer()
exten => s,n,Wait(1)
exten => s,n,Set(CHANNEL(language)=en)

; Play welcome message
; Record your own: asterisk -rx "file convert /tmp/welcome.wav /var/lib/asterisk/sounds/attica-welcome.gsm"
exten => s,n,Background(hello-world)

; Wait for input: 1=Sales, 2=Support, 0=Operator
exten => s,n,WaitExten(5)

; If no input, go to operator
exten => s,n,Goto(ivr-main,0,1)

; Option 1 — Sales / Outbound Team
exten => 1,1,NoOp(IVR: Caller pressed 1 - Sales)
exten => 1,n,Goto(queue-sales,s,1)

; Option 2 — Support / Inbound Team
exten => 2,1,NoOp(IVR: Caller pressed 2 - Support)
exten => 2,n,Goto(queue-support,s,1)

; Option 0 — Operator
exten => 0,1,NoOp(IVR: Caller pressed 0 - Operator)
 same => n,Set(CALLFILENAME=\${STRFTIME(\${EPOCH},,%Y%m%d-%H%M%S)}-\${FILTER(0-9,\${CALLERID(num)})}-outbound)
 same => n,MixMonitor(/var/spool/asterisk/monitor/${CALLFILENAME}.wav,b)
exten => 0,n,Dial(SIP/1001,30,tTo)
exten => 0,n,Voicemail(1001@default,u)
exten => 0,n,Hangup()

; Invalid input
exten => i,1,Playback(invalid)
exten => i,n,Goto(ivr-main,s,1)

; Timeout
exten => t,1,Goto(ivr-main,0,1)

