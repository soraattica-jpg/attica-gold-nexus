 same => n(done),NoOp(Language queue hangup outcome sync complete)

;==========================================================
; ONE-DAY 2-OF-5 INCOMING GATE
; Applies after a valid language/default-language route and before CRM save/Queue().
; Disabled unless ATTICA_2OF5_TARGET_DATE equals today's IST date.
; Uses only in-memory GLOBAL vars; the counter resets on Asterisk restart/reload.
;==========================================================
[temp-incoming-2-of-5]
exten => s,1,NoOp(One-day 2-of-5 gate check caller=${CALLERID(num)} target=${ATTICA_2OF5_TARGET_DATE})
 same => n,Set(GATE_TARGET=${ATTICA_2OF5_TARGET_DATE})
 same => n,GotoIf($["${GATE_TARGET}"=""]?allow)
 same => n,Set(GATE_TODAY=${STRFTIME(${EPOCH},Asia/Kolkata,%Y-%m-%d)})
 same => n,GotoIf($["${GATE_TODAY}"!="${GATE_TARGET}"]?expired)
 same => n,GotoIf($["${GATE_ALREADY_CHECKED}"="1"]?allow)
 same => n,Set(GATE_ALREADY_CHECKED=1)
 same => n,Set(GATE_LOCK_OK=${LOCK(attica-temp-2of5)})
 same => n,GotoIf($["${GATE_LOCK_OK}"!="1"]?allow)
 same => n,Set(GATE_STOP_LIMIT=${GLOBAL(ATTICA_2OF5_STOP_LIMIT)})
 same => n,ExecIf($["${GATE_STOP_LIMIT}"=""]?Set(GATE_STOP_LIMIT=0))
 same => n,Set(GATE_STOP_COUNT=${GLOBAL(ATTICA_2OF5_STOP_COUNT)})
 same => n,ExecIf($["${GATE_STOP_COUNT}"=""]?Set(GATE_STOP_COUNT=0))
 same => n,Set(GATE_STOP_COUNT=$[${GATE_STOP_COUNT} + 1])
 same => n,Set(GLOBAL(ATTICA_2OF5_STOP_COUNT)=${GATE_STOP_COUNT})
 same => n,GotoIf($[${GATE_STOP_LIMIT} > 0 & ${GATE_STOP_COUNT} > ${GATE_STOP_LIMIT}]?hard-reject)
 same => n,Set(GATE_RATE_SECONDS=${GLOBAL(ATTICA_2OF5_RATE_SECONDS)})
 same => n,ExecIf($["${GATE_RATE_SECONDS}"=""]?Set(GATE_RATE_SECONDS=0))
 same => n,GotoIf($[${GATE_RATE_SECONDS} <= 0]?cycle-check)
 same => n,Set(GATE_LAST_ROUTE_EPOCH=${GLOBAL(ATTICA_2OF5_LAST_ROUTE_EPOCH)})
 same => n,ExecIf($["${GATE_LAST_ROUTE_EPOCH}"=""]?Set(GATE_LAST_ROUTE_EPOCH=0))
 same => n,Set(GATE_RATE_REMAINING=$[${GATE_RATE_SECONDS} - (${EPOCH} - ${GATE_LAST_ROUTE_EPOCH})])
 same => n,GotoIf($[${GATE_LAST_ROUTE_EPOCH} > 0 & ${GATE_RATE_REMAINING} > 0]?rate-reject)
 same => n,Set(GLOBAL(ATTICA_2OF5_LAST_ROUTE_EPOCH)=${EPOCH})
 same => n,Set(GLOBAL(ATTICA_2OF5_COUNT)=1)
 same => n,Set(GATE_UNLOCK_OK=${UNLOCK(attica-temp-2of5)})
 same => n,Goto(allow)
 same => n(cycle-check),NoOp(2-of-5 cycle mode active)
 same => n,Set(GATE_COUNT=${GLOBAL(ATTICA_2OF5_COUNT)})
 same => n,ExecIf($["${GATE_COUNT}"=""]?Set(GATE_COUNT=0))
 same => n,Set(GATE_COUNT=$[${GATE_COUNT} + 1])
 same => n,ExecIf($[${GATE_COUNT} > 5]?Set(GATE_COUNT=1))
 same => n,Set(GLOBAL(ATTICA_2OF5_COUNT)=${GATE_COUNT})
 same => n,Set(GATE_UNLOCK_OK=${UNLOCK(attica-temp-2of5)})
 same => n,GotoIf($[${GATE_COUNT}=1]?allow)
 same => n,GotoIf($[${GATE_COUNT}=3]?allow:reject)
 same => n(expired),Set(GLOBAL(ATTICA_2OF5_COUNT)=0)
 same => n,Set(GLOBAL(ATTICA_2OF5_REJECTED_COUNT)=0)
 same => n,Set(GLOBAL(ATTICA_2OF5_TOTAL_REJECTED_COUNT)=0)
 same => n,Set(GLOBAL(ATTICA_2OF5_STOP_LIMIT)=0)
 same => n,Set(GLOBAL(ATTICA_2OF5_STOP_COUNT)=0)
 same => n,Set(GLOBAL(ATTICA_2OF5_RATE_SECONDS)=0)
 same => n,Set(GLOBAL(ATTICA_2OF5_LAST_ROUTE_EPOCH)=0)
 same => n,Return()
 same => n(allow),NoOp(One-day 2-of-5 ALLOW position=${GATE_COUNT} date=${GATE_TODAY})
 same => n,Return()
 same => n(hard-reject),Set(GATE_COUNT=BLOCK)
 same => n,Set(GATE_UNLOCK_OK=${UNLOCK(attica-temp-2of5)})
 same => n,NoOp(One-day 2-of-5 HARD REJECT after stop count=${GATE_STOP_COUNT} limit=${GATE_STOP_LIMIT} date=${GATE_TODAY})
 same => n,Goto(reject)
 same => n(rate-reject),Set(GATE_COUNT=RATE)
 same => n,Set(GATE_UNLOCK_OK=${UNLOCK(attica-temp-2of5)})
 same => n,NoOp(One-day rate gate REJECT remaining=${GATE_RATE_REMAINING}s last=${GATE_LAST_ROUTE_EPOCH} rate=${GATE_RATE_SECONDS} date=${GATE_TODAY})
 same => n,Goto(reject)
 same => n(reject),NoOp(One-day 2-of-5 REJECT position=${GATE_COUNT} date=${GATE_TODAY})
 same => n,Set(GATE_REJECTED_COUNT=${GLOBAL(ATTICA_2OF5_REJECTED_COUNT)})
 same => n,ExecIf($["${GATE_REJECTED_COUNT}"=""]?Set(GATE_REJECTED_COUNT=0))
 same => n,Set(GATE_REJECTED_COUNT=$[${GATE_REJECTED_COUNT} + 1])
 same => n,Set(GLOBAL(ATTICA_2OF5_REJECTED_COUNT)=${GATE_REJECTED_COUNT})
 same => n,Set(GATE_TOTAL_REJECTED_COUNT=${GLOBAL(ATTICA_2OF5_TOTAL_REJECTED_COUNT)})
 same => n,ExecIf($["${GATE_TOTAL_REJECTED_COUNT}"=""]?Set(GATE_TOTAL_REJECTED_COUNT=0))
 same => n,Set(GATE_TOTAL_REJECTED_COUNT=$[${GATE_TOTAL_REJECTED_COUNT} + 1])
 same => n,Set(GLOBAL(ATTICA_2OF5_TOTAL_REJECTED_COUNT)=${GATE_TOTAL_REJECTED_COUNT})
 same => n,Set(__TEMP_2OF5_DROP=1)
 same => n,Set(TEMP_INBOUND_DROP=1)
 same => n,Set(CDR_PROP(disable)=1)
 same => n,Set(CDR(userfield)=SYSTEM_REJECTED_2_OF_5_TEST)
 same => n,Hangup(21)

;==========================================================
; MISSED CALL HANDLER — Save to DB
;==========================================================
[attica-missed]
exten => s,1,NoOp(Missed call from ${CALLERID(num)})
 same => n,System(curl -s -X POST http://localhost:3001/api/calls -H "Content-Type: application/json" -d '{"id":"MISS-'${EPOCH}'","callerId":"${CALLERID(num)}","callerName":"Missed","customerName":"Unknown","agentId":"NONE","agentName":"No Agent","direction":"incoming","status":"missed","duration":"00:00","time":"${STRFTIME(${EPOCH},Asia/Kolkata,%H:%M)}","date":"${STRFTIME(${EPOCH},Asia/Kolkata,%Y-%m-%d)}","language":"${LANG_SELECTED}","businessType":"${IVR_BUSINESS_TYPE}","hasRecording":false,"branch":"","place":"","purpose":"${IVR_PURPOSE}","callbackStatus":"Pending","followUpFlag":true}')
 same => n,Playback(vm-goodbye)
 same => n,Hangup()

; Test recording
[default]
exten => *99,1,Answer()
 same => n,MixMonitor(/var/spool/asterisk/monitor/test-recording.wav,b)
 same => n,Playback(demo-echotest)
 same => n,Echo()
 same => n,Hangup()

