;==========================================================
; Extensions Configuration - Attica Gold Private Limited
; TATA SIP Trunk
; DID: 8068711201 | Username: 68711200
;==========================================================

[general]
static=yes
writeprotect=no
clearglobalvars=no
priorityjumping=no

[globals]
TRUNK=tatasip
PILOTNUM=8068711200
OUTBOUND_DID=8068711209
OUTBOUND_CLI=68711209
TATA_DID_NO_AC=68711209
TATA_PILOT_FULL=8068711200
TATA_PILOT_NO_AC=68711200
DOMAIN=10.53.179.2
OUTBOUND_RING_TIMEOUT=60
NEW_TATA_TRUNK=TATA_NEW
NEW_TATA_PILOT=8065200220
NEW_TATA_DEFAULT_OUTBOUND_DID=8065200221
NEW_TATA_DOMAIN=ka.ims.ttl.in
; One-day incoming 2-of-5 test gate. Leave blank to disable.
; Set to an IST date like 2026-08-14, then run: asterisk -rx "dialplan reload"
ATTICA_2OF5_TARGET_DATE=
ATTICA_2OF5_COUNT=0
ATTICA_2OF5_REJECTED_COUNT=0
ATTICA_2OF5_TOTAL_REJECTED_COUNT=0
ATTICA_2OF5_STOP_LIMIT=0
ATTICA_2OF5_STOP_COUNT=0
ATTICA_2OF5_RATE_SECONDS=0
ATTICA_2OF5_LAST_ROUTE_EPOCH=0

;==========================================================
; TATA OUTBOUND IDENTITY
;==========================================================
[tata-outbound-identity]
exten => s,1,NoOp(Set Tata outbound identity from dynamic AstDB DID)
 same => n,Set(TATA_ACTIVE_DID=${DB(TATA/outbound_did)})
 same => n,ExecIf($["${TATA_ACTIVE_DID}"=""]?Set(TATA_ACTIVE_DID=${OUTBOUND_DID}))
 same => n,Set(TATA_ACTIVE_DID_NO_AC=${TATA_ACTIVE_DID:2})
 same => n,NoOp(Tata outbound active DID ${TATA_ACTIVE_DID} CLI ${TATA_ACTIVE_DID_NO_AC} PPI ${TATA_PILOT_NO_AC})
 same => n,Set(CALLERID(num)=${TATA_ACTIVE_DID_NO_AC})
 same => n,Set(CALLERID(name)=ATTICA GOLD)
 same => n,SipRemoveHeader()
 same => n,SipAddHeader(P-Preferred-Identity: <sip:${TATA_PILOT_NO_AC}@${DOMAIN}>)
 same => n,Return()

;==========================================================
; NEW TATA SIP CIRCUIT OUTBOUND IDENTITY
; Pilot: 8065200220 | approved outbound CLI range: 8065200221-8065200399
; The active CLI can be set in AstDB at NEW_TATA/outbound_did.  When unset,
; use the first approved outbound DID.  The pilot is used only as PPI.
;==========================================================
[new-tata-outbound-identity]
exten => s,1,NoOp(Set new Tata outbound identity from active approved DID)
 same => n,Set(NEW_TATA_ACTIVE_DID=${FILTER(0-9,${DB(NEW_TATA/outbound_did)})})
 same => n,ExecIf($[${LEN(${NEW_TATA_ACTIVE_DID})} = 0]?Set(NEW_TATA_ACTIVE_DID=${NEW_TATA_DEFAULT_OUTBOUND_DID}))
 same => n,GotoIf($[${LEN(${NEW_TATA_ACTIVE_DID})} != 10]?invalid-cli)
 same => n,GotoIf($["${NEW_TATA_ACTIVE_DID:0:7}" != "8065200"]?invalid-cli)
 same => n,Set(NEW_TATA_DID_SUFFIX=${NEW_TATA_ACTIVE_DID:7:3})
 same => n,GotoIf($[${NEW_TATA_DID_SUFFIX} < 221 | ${NEW_TATA_DID_SUFFIX} > 399]?invalid-cli)
 same => n,NoOp(New Tata outbound active DID ${NEW_TATA_ACTIVE_DID} PPI ${NEW_TATA_PILOT})
 same => n,Set(CALLERID(num)=${NEW_TATA_ACTIVE_DID})
 same => n,Set(CALLERID(name)=ATTICA GOLD)
 same => n,SipRemoveHeader()
 same => n,SipAddHeader(P-Preferred-Identity: <sip:${NEW_TATA_PILOT}@${NEW_TATA_DOMAIN}>)
 same => n,Return()
 same => n(invalid-cli),NoOp(Invalid new Tata outbound DID - using ${NEW_TATA_DEFAULT_OUTBOUND_DID})
 same => n,Set(NEW_TATA_ACTIVE_DID=${NEW_TATA_DEFAULT_OUTBOUND_DID})
 same => n,Set(CALLERID(num)=${NEW_TATA_ACTIVE_DID})
 same => n,Set(CALLERID(name)=ATTICA GOLD)
 same => n,SipRemoveHeader()
 same => n,SipAddHeader(P-Preferred-Identity: <sip:${NEW_TATA_PILOT}@${NEW_TATA_DOMAIN}>)
 same => n,Return()

[tata-outbound-dial]
exten => s,1,NoOp(Select Tata outbound circuit for ${ARG1})
 same => n,Set(TATA_OUTBOUND_ROUTE=${DB(TATA_ROUTING/primary)})
 same => n,ExecIf($["${TATA_OUTBOUND_ROUTE}"=""]?Set(TATA_OUTBOUND_ROUTE=TATA_PRIMARY))
 same => n,GotoIf($["${TATA_OUTBOUND_ROUTE}"="TATA_NEW"]?new:primary)
 same => n(primary),Gosub(tata-primary-outbound-dial,s,1(${ARG1},${ARG2}))
 same => n,Return()
 same => n(new),Gosub(tata-new-outbound-dial,s,1(${ARG1},${ARG2}))
 same => n,Return()

[tata-primary-outbound-dial]
exten => s,1,NoOp(Existing Tata outbound dial ${ARG1})
 same => n,Gosub(attica-intake-track,s,1)
 same => n,Set(TATA_DIAL_NUM=${FILTER(0-9,${ARG1})})
 same => n,Set(TATA_DIAL_OUT=0${TATA_DIAL_NUM})
 same => n,Set(TATA_DIAL_TIMEOUT=${IF($["${ARG2}"=""]?${OUTBOUND_RING_TIMEOUT}:${ARG2})})
 same => n,ExecIf($[${TATA_DIAL_TIMEOUT} > ${OUTBOUND_RING_TIMEOUT}]?Set(TATA_DIAL_TIMEOUT=${OUTBOUND_RING_TIMEOUT}))
 same => n,Gosub(tata-outbound-identity,s,1)
 ; Use interruptible ringback: Tata early media (183/RTP) must replace it when available.
 same => n,Dial(SIP/${TATA_DIAL_OUT}@tatasip,${TATA_DIAL_TIMEOUT},RtTo)
 same => n,NoOp(Tata outbound result number=${TATA_DIAL_OUT} dialstatus=${DIALSTATUS} hangupcause=${HANGUPCAUSE} dialedtime=${DIALEDTIME} answeredtime=${ANSWEREDTIME})
 ; Only a carrier-reported busy result is treated as busy. A normal answered hangup is not.
 same => n,GotoIf($["${DIALSTATUS}"="BUSY" | "${HANGUPCAUSE}"="17"]?carrier-busy)
 same => n,Return()
 same => n(carrier-busy),NoOp(Tata carrier BUSY number=${TATA_DIAL_OUT} cause=${HANGUPCAUSE})
 same => n,Busy(2)
 same => n,Return()

[tata-new-outbound-dial]
exten => s,1,NoOp(TATA_NEW outbound dial ${ARG1})
 same => n,Gosub(attica-intake-track,s,1)
 same => n,Set(__TRUNK_CODE=TATA_NEW)
 same => n,Set(__CARRIER_TRUNK=CAMPAIGN_CALLS)
 same => n,Set(__CALL_DIRECTION=OUTGOING)
 same => n,Set(__TATA_PILOT=${NEW_TATA_PILOT})
 same => n,Set(CHANNEL(accountcode)=CAMPAIGN_CALLS_OUT)
 same => n,Set(GROUP(tata-new)=all)
 same => n,Set(GROUP(tata-new-direction)=outgoing)
 same => n,Set(NEW_TATA_ACTIVE_CHANNELS=${GROUP_COUNT(all@tata-new)})
 same => n,Set(NEW_TATA_OUTBOUND_CHANNELS=${GROUP_COUNT(outgoing@tata-new-direction)})
 same => n,GotoIf($[${NEW_TATA_ACTIVE_CHANNELS} > 60 | ${NEW_TATA_OUTBOUND_CHANNELS} > 50]?capacity)
 same => n,Set(TATA_DIAL_NUM=${FILTER(0-9,${ARG1})})
 same => n,Set(TATA_DIAL_OUT=0${TATA_DIAL_NUM})
 same => n,Set(TATA_DIAL_TIMEOUT=${IF($["${ARG2}"=""]?${OUTBOUND_RING_TIMEOUT}:${ARG2})})
 same => n,ExecIf($[${TATA_DIAL_TIMEOUT} > ${OUTBOUND_RING_TIMEOUT}]?Set(TATA_DIAL_TIMEOUT=${OUTBOUND_RING_TIMEOUT}))
 same => n,Gosub(new-tata-outbound-identity,s,1)
 ; Uppercase R allows real Tata early media to replace local ringback.
 same => n,Dial(SIP/${TATA_DIAL_OUT}@${NEW_TATA_TRUNK},${TATA_DIAL_TIMEOUT},RtTo)
 same => n,NoOp(TATA_NEW outbound result number=${TATA_DIAL_OUT} cli=${NEW_TATA_ACTIVE_DID} dialstatus=${DIALSTATUS} hangupcause=${HANGUPCAUSE} dialedtime=${DIALEDTIME} answeredtime=${ANSWEREDTIME})
 same => n,GotoIf($["${DIALSTATUS}"="BUSY" | "${HANGUPCAUSE}"="17"]?carrier-busy)
 same => n,Return()
 same => n(carrier-busy),NoOp(TATA_NEW carrier BUSY number=${TATA_DIAL_OUT} cause=${HANGUPCAUSE})
 same => n,Busy(2)
 same => n,Return()
 same => n(capacity),NoOp(TATA_NEW capacity reserved active=${NEW_TATA_ACTIVE_CHANNELS} outbound=${NEW_TATA_OUTBOUND_CHANNELS})
 same => n,Hangup(34)

; GSM outbound has been removed. All production outbound calls use Tata SIP.

