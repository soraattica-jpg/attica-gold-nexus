 same => n,ExecIf($["${IS_VALID_STICKY_CALLER}"="1" & "${DIALSTATUS}"="ANSWER"]?Set(DB(attica-sticky/${CALLER_STICKY_SCOPE})=${STICKY_AGENT}))
 same => n,GotoIf($["${DIALSTATUS}"="ANSWER"]?queue-complete,1)
