 same => n,Set(CALLFILENAME=\${STRFTIME(\${EPOCH},,%Y%m%d-%H%M%S)}-\${FILTER(0-9,\${CALLERID(num)})}-outbound)
 same => n,MixMonitor(/var/spool/asterisk/monitor/${CALLFILENAME}.wav,b)
