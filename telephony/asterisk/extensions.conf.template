;==========================================================
; TATA_NEW INBOUND NORMALIZATION AND ENTRY
; Accept pilot/range as 10 digit, 0-prefixed, +91/E.164 or 8-digit local DID.
;==========================================================
[from-tata-new]
exten => s,1,NoOp(TATA_NEW inbound default from ${CALLERID(num)} to ${EXTEN})
 same => n,Gosub(tata-new-did-entry,s,1(8065200220))
 same => n,Hangup()
exten => _X!,1,Gosub(tata-new-did-entry,s,1(${EXTEN}))
 same => n,Hangup()
exten => _+X!,1,Gosub(tata-new-did-entry,s,1(${EXTEN}))
 same => n,Hangup()

[tata-new-did-entry]
exten => s,1,Set(TATA_NEW_DID=${FILTER(0-9,${ARG1})})
 same => n,ExecIf($[${LEN(${TATA_NEW_DID})}=12 & "${TATA_NEW_DID:0:2}"="91"]?Set(TATA_NEW_DID=${TATA_NEW_DID:2}))
 same => n,ExecIf($[${LEN(${TATA_NEW_DID})}=11 & "${TATA_NEW_DID:0:1}"="0"]?Set(TATA_NEW_DID=${TATA_NEW_DID:1}))
 same => n,ExecIf($[${LEN(${TATA_NEW_DID})}=8 & "${TATA_NEW_DID:0:5}"="65200"]?Set(TATA_NEW_DID=80${TATA_NEW_DID}))
 same => n,GotoIf($[${LEN(${TATA_NEW_DID})} != 10]?invalid)
 same => n,GotoIf($["${TATA_NEW_DID:0:7}" != "8065200"]?invalid)
 same => n,Set(TATA_NEW_DID_SUFFIX=${TATA_NEW_DID:7:3})
 same => n,GotoIf($[${TATA_NEW_DID_SUFFIX} >= 220 & ${TATA_NEW_DID_SUFFIX} <= 399]?valid:invalid)
 same => n(valid),Goto(tata-new-inbound,${TATA_NEW_DID},1)
 same => n(invalid),NoOp(Reject TATA_NEW invalid DID raw=${ARG1} normalized=${TATA_NEW_DID})
 same => n,Hangup(1)

