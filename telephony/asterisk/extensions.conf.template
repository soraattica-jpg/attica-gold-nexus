[attica-block-check]
exten => s,1,NoOp(PBX blocked-number check for ${ARG1})
 same => n,Set(BLOCK_PHONE=${FILTER(0-9,${ARG1})})
 same => n,ExecIf($[${LEN(${BLOCK_PHONE})} > 10]?Set(BLOCK_PHONE=${BLOCK_PHONE:-10}))
 same => n,ExecIf($[${LEN(${BLOCK_PHONE})} = 0]?Return())
 same => n,Set(IS_BLOCKED=${DB_EXISTS(attica-blocked/${BLOCK_PHONE})})
 same => n,NoOp(PBX blocked-number result ${BLOCK_PHONE} => ${IS_BLOCKED})
 same => n,GotoIf($["${IS_BLOCKED}"="1"]?blocked,1)
 same => n,Return()

exten => blocked,1,NoOp(Rejecting blocked caller ${BLOCK_PHONE})
 same => n,Hangup(21)

[attica-inbound-dedupe]
exten => s,1,Set(DUPLICATE_CALLER_KEY=${FILTER(0-9,${ARG1})})
 same => n,ExecIf($[${LEN(${DUPLICATE_CALLER_KEY})} > 10]?Set(DUPLICATE_CALLER_KEY=${DUPLICATE_CALLER_KEY:-10}))
 same => n,Set(IS_DUPLICATE_INBOUND=0)
 same => n,Set(DUPLICATE_CALLER_COUNT=0)
 same => n,ExecIf($["${DUPLICATE_CALLER_KEY}" != ""]?Set(GROUP(inbound-dup)=caller-${DUPLICATE_CALLER_KEY}))
 same => n,ExecIf($["${DUPLICATE_CALLER_KEY}" != ""]?Set(DUPLICATE_CALLER_COUNT=${GROUP_COUNT(caller-${DUPLICATE_CALLER_KEY}@inbound-dup)}))
 same => n,ExecIf($[${DUPLICATE_CALLER_COUNT} > 1]?Set(IS_DUPLICATE_INBOUND=1))
 same => n,ExecIf($["${IS_DUPLICATE_INBOUND}"="1"]?Verbose(2,Duplicate inbound caller ${DUPLICATE_CALLER_KEY} allowed with ${DUPLICATE_CALLER_COUNT} live legs))
 same => n,Return()

