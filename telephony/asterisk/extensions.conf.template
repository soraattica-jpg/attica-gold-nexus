 same => n,ExecIf($["${IS_VALID_STICKY_CALLER}"="1" & "${ANSWERED_AGENT}" != ""]?Set(DB(attica-sticky/${CALLER_STICKY_SCOPE})=${ANSWERED_AGENT}))
 same => n,GotoIf($["${ANSWERED_AGENT}" != ""]?queue-complete,1)
 same => n,Goto(attica-missed,s,1)

exten => telugu,1,Queue(attica-telugu,tb(attica-intake-track^s^1))
 same => n,Set(ANSWERED_AGENT=${CUT(MEMBERINTERFACE,/,2)})
 same => n,ExecIf($["${IS_VALID_STICKY_CALLER}"="1" & "${ANSWERED_AGENT}" != ""]?Set(DB(attica-sticky/${CALLER_STICKY_SCOPE})=${ANSWERED_AGENT}))
 same => n,GotoIf($["${ANSWERED_AGENT}" != ""]?queue-complete,1)
 same => n,Goto(attica-missed,s,1)

exten => hindi,1,Queue(attica-hindi,tb(attica-intake-track^s^1))
 same => n,Set(ANSWERED_AGENT=${CUT(MEMBERINTERFACE,/,2)})
 same => n,ExecIf($["${IS_VALID_STICKY_CALLER}"="1" & "${ANSWERED_AGENT}" != ""]?Set(DB(attica-sticky/${CALLER_STICKY_SCOPE})=${ANSWERED_AGENT}))
 same => n,GotoIf($["${ANSWERED_AGENT}" != ""]?queue-complete,1)
 same => n,Goto(attica-missed,s,1)

exten => english,1,Queue(attica-english,tb(attica-intake-track^s^1))
 same => n,Set(ANSWERED_AGENT=${CUT(MEMBERINTERFACE,/,2)})
 same => n,ExecIf($["${IS_VALID_STICKY_CALLER}"="1" & "${ANSWERED_AGENT}" != ""]?Set(DB(attica-sticky/${CALLER_STICKY_SCOPE})=${ANSWERED_AGENT}))
 same => n,GotoIf($["${ANSWERED_AGENT}" != ""]?queue-complete,1)
 same => n,Goto(attica-missed,s,1)

exten => queue-complete,1,Hangup()
exten => h,1,NoOp(Language queue hangup caller=${CALLERID(num)} lang=${LANG_SELECTED} purpose=${IVR_PURPOSE} queue=${QUEUESTATUS} answeredAgent=${ANSWERED_AGENT} member=${MEMBERINTERFACE} dialstatus=${DIALSTATUS} hangupcause=${HANGUPCAUSE} bridgepeer=${BRIDGEPEER})
 same => n,Verbose(2,Attica language queue hangup caller=${CALLERID(num)} lang=${LANG_SELECTED} purpose=${IVR_PURPOSE} queue=${QUEUESTATUS} answeredAgent=${ANSWERED_AGENT} member=${MEMBERINTERFACE} dialstatus=${DIALSTATUS} hangupcause=${HANGUPCAUSE} bridgepeer=${BRIDGEPEER})
 same => n,GotoIf($["${TEMP_INBOUND_DROP}"="1" | "${TEMP_2OF5_DROP}"="1"]?done)
 same => n,GotoIf($["${ANSWERED_AGENT}"!="" | "${BRIDGEPEER}"!=""]?done)
