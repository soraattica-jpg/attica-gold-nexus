 same => n,ExecIf($["${OUTNUM:0:2}" = "91"]?Set(OUTNUM=${OUTNUM:2}))
 same => n,ExecIf($["${OUTNUM:0:1}" = "0"]?Set(OUTNUM=${OUTNUM:1}))
exten => _9X.,n,Gosub(tata-outbound-dial,s,1(${OUTNUM},${OUTBOUND_RING_TIMEOUT}))
exten => _9X.,n,Hangup()
exten => h,1,NoOp(Airtel outbound hangup caller=${CALLERID(num)} dialstatus=${DIALSTATUS} hangupcause=${HANGUPCAUSE} bridgepeer=${BRIDGEPEER})
 same => n,Verbose(2,Attica airtel outbound hangup caller=${CALLERID(num)} dialstatus=${DIALSTATUS} hangupcause=${HANGUPCAUSE} bridgepeer=${BRIDGEPEER})

