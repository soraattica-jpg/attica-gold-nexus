<IfModule mod_rewrite.c>
  RewriteEngine On

  # Keep API requests on the backend proxy and serve real files directly.
  RewriteRule ^api($|/) - [L]
  RewriteRule ^recordings($|/) - [L]
  RewriteRule ^agent-intake-test/?$ agent-intake-test.html [L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d [OR]
  RewriteCond %{REQUEST_FILENAME} -l
  RewriteRule ^ - [L]

  # Route SPA deep links like /admin/users back to the app shell.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(css|js|mjs|png|jpg|jpeg|gif|svg|webp|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
